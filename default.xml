  <project remote="github" name="Freescale/meta-freescale-distro" path="sources/meta-freescale-distro"/>

  <!-- conf -->
  <project remote="ossystems" name="ossystems-yocto-platform" path="sources/conf/repo"/>
  <project remote="ossystems" name="ossystems-yocto-config" path="sources/conf/tools"/>

  <!-- ye -->
  <project remote="github" revision="master" name="OSSystemsEmbeddedLinux/ye" path="sources/ye"/>
