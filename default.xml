<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote fetch="ssh://git@github.com" name="github"/>
  <remote fetch="ssh://code.ossystems.io:29418" name="ossystems"/>

  <default revision="rocko" sync-j="4"/>

  <project remote="github" name="openembedded/openembedded-core" path="sources/openembedded-core"/>
  <project remote="github" revision="1.36" name="openembedded/bitbake" path="sources/bitbake"/>
